{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Ask Bryge",
  "id": "bryge-ask-app",
  "info": {
    "keywords": [
      "app",
      "bryge",
      "ai",
      "natural language"
    ],
    "description": "Ask a dashboard's data questions in plain language. Bryge reads the database the dashboard already charts, works out how its tables relate, then writes the query and answers with the data behind it.",
    "author": {
      "name": "Bryge",
      "url": "https://bryge.io"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://bryge.io"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/Bryge/Bryge.io/tree/main/grafana-plugin"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/Bryge/Bryge.io/issues"
      }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "extensions": {
    "addedLinks": [
      {
        "targets": [
          "grafana/dashboard/panel/menu"
        ],
        "title": "Ask Bryge about this panel",
        "description": "Ask a question about this panel in plain language"
      }
    ]
  },
  "includes": [
    {
      "type": "datasource",
      "name": "Bryge API",
      "path": "datasource/plugin.json"
    },
    {
      "type": "panel",
      "name": "Bryge Chat",
      "path": "panel/plugin.json"
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.1.0",
    "plugins": []
  },
  "backend": false
}